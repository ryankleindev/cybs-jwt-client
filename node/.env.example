# Copy this to `.env` and fill in your values. `.env` is gitignored.

# Sandbox host. Production is api.cybersource.com
CYBS_RUN_ENVIRONMENT=apitest.cybersource.com

# Your merchant id (MID).
CYBS_MERCHANT_ID=your_mid

# Meta key (portfolio-based) auth. Set true if you authenticate with a portfolio id.
CYBS_USE_META_KEY=true
CYBS_PORTFOLIO_ID=your_portfolio_id

# Request p12 — holds your signing key AND the Cybersource request-MLE cert.
CYBS_REQUEST_P12_PATH=keys/rk_cp_sandbox_request.p12
CYBS_REQUEST_P12_PASSWORD=your_request_p12_password

# Shared secret signing — an alternative to the request p12. When CYBS_SHARED_SECRET_KEY_ID is
# set, examples/tokenize.js signs with the shared secret instead. Create it in Business Center:
# Payment Configuration > Key Management > Generate key > REST – Shared Secret.
# CYBS_SHARED_SECRET_KEY_ID=your_shared_secret_key_id
# CYBS_SHARED_SECRET=your_base64_shared_secret
# CYBS_SHARED_SECRET_ALG=HS256

# Response p12 — holds your response-MLE private key, plus the Cybersource request-MLE cert.
# Needed for response MLE, and for request MLE when signing with a shared secret.
CYBS_RESPONSE_P12_PATH=keys/rk_cp_sandbox_response.p12
CYBS_RESPONSE_P12_PASSWORD=your_response_p12_password

# Per-run MLE for the examples — two independent booleans.
CYBS_MLE_REQUEST=false
CYBS_MLE_RESPONSE=false
